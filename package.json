{
	"name": "pi-memory",
	"version": "0.5.0",
	"description": "Pi coding agent extension for memory with qmd-powered semantic search across daily logs, long-term memory, and scratchpad",
	"main": "dist/index.js",
	"type": "module",
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-package",
		"memory",
		"search",
		"qmd",
		"scratchpad",
		"daily-log"
	],
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"author": "jayzeng",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kosuke-zhang/pi-memory.git"
	},
	"bugs": {
		"url": "https://github.com/kosuke-zhang/pi-memory/issues"
	},
	"homepage": "https://github.com/kosuke-zhang/pi-memory#readme",
	"files": [
		"dist",
		"index.ts",
		"hosted.ts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"lint": "biome check .",
		"test": "bun test test/unit.test.ts",
		"test:e2e": "npx tsx test/e2e.ts",
		"test:eval": "bun test/eval-recall.ts",
		"test:hosted": "node --import tsx --test test/hosted.test.ts",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"tsx": "^4.0.0",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0"
	},
	"overrides": {
		"rimraf": "^6.1.3",
		"glob": "^13.0.3"
	},
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./hosted": {
			"types": "./dist/hosted.d.ts",
			"import": "./dist/hosted.js"
		}
	}
}
